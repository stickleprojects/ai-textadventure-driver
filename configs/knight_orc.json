        "death": [
            "you have died",
            "you are dead",
            "killed"
        ],
        "finished": [
            "congratulations",
            "you have finished",
            "the end"
        ],
        "score": [
            "you score \\d+ out of \\d+"
        ]
    },
    "navigation": {
        "fast_nav_command": "run to {target}",
        "full_nav_command": "go to {target}"
    },
    "npc_commands": {
        "wait_for_command": "wait for {npc}"
    },
    "theft_patterns": [
        "(?:just\\s+)?stole\\s+(?:the\\s+)?(?P<item>.+?)\\s+from\\s+",
        "takes?\\s+(?:the\\s+)?(?P<item>.+?)\\s+from\\s+"
    ],
    "room_patterns": [
        "you (?:go \\w+ and )?are (?:in|on|at|beside) (?P<room>.+?)(?=\\s*(?:exits? leads?|an exit leads|you can see|in the distance is)|$)",
        "you (?:go \\w+ and )?are (?P<room>(?:outside|inside) .+?)(?=\\s*(?:exits? leads?|an exit leads|you can see|in the distance is)|$)"
    ],
    "exit_clause_patterns": [
        "(?:exits? leads?|an exit leads) (?P<exits>[^.]+)\\."
    ],
    "visible_entity_patterns": [
        "you can see (?P<entities>[^.]+)\\."
    ],
    "take_confirmation_patterns": [
        "you take\\b",
        "^taken\\.?$",
        "^ok\\.?$"
    ],
    "hints": [
        "Say hello to denzyl as he can help you with your quest.",
        "NPCs will steal treasure from you if they see you carrying it — put it inside a sack or box."
    ]
