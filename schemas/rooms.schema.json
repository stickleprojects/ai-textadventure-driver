{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knight Orc world graph (rooms sidecar)",
  "type": "object",
  "required": ["nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "description": "[from_room, to_room, direction_label]",
        "items": { "type": "string" },
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}
