{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fix plan index",
  "type": "object",
  "required": ["next_id", "plans"],
  "additionalProperties": false,
  "properties": {
    "next_id": { "type": "integer", "minimum": 1 },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plan_id", "anomaly_type", "summary", "severity", "status", "source_runs", "plan_file"],
        "additionalProperties": true,
        "properties": {
          "plan_id":      { "type": "string", "pattern": "^P\\d+$" },
          "anomaly_type": { "type": "string", "minLength": 1 },
          "summary":      { "type": "string", "minLength": 1 },
          "severity":     { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "status":       { "type": "string", "enum": ["open", "deferred", "fixed", "in_progress"] },
          "source_runs":  { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "anomaly_ids":  { "type": "array", "items": { "type": "string" } },
          "plan_file":    { "type": "string", "minLength": 1 },
          "notes":        { "type": "string" },
          "fixed_in":     { "type": "string" },
          "deferred_reason": { "type": "string" }
        }
      }
    }
  }
}
