{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knight Orc game config",
  "type": "object",
  "required": ["prompt_pattern", "candidate_verbs", "creature_words", "hard_failure_patterns", "soft_failure_patterns", "end_state_patterns"],
  "additionalProperties": false,
  "properties": {
    "prompt_pattern": { "type": "string", "minLength": 1 },
    "candidate_verbs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "creature_words": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "hard_failure_patterns": { "type": "array", "items": { "type": "string" } },
    "soft_failure_patterns": { "type": "array", "items": { "type": "string" } },
    "end_state_patterns": {
      "type": "object",
      "required": ["death", "finished", "score"],
      "additionalProperties": false,
      "properties": {
        "death":    { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "finished": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "score":    { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fast_nav_command": { "type": "string" },
        "full_nav_command": { "type": "string" }
      }
    },
    "npc_commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wait_for_command": { "type": "string" }
      }
    },
    "hints": { "type": "array", "items": { "type": "string" } }
  }
}
