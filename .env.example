# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.
#
# Variable references ($VAR or ${VAR}) are resolved from the environment
# at load time, so you can keep secrets in your shell profile and just
# point here:
#   export DEEPSEEK_API_KEY=sk-...   # in ~/.bashrc or ~/.zshrc
#   LLM_API_KEY=$DEEPSEEK_API_KEY    # in .env — no secret stored in file
#
# Keyring references are also supported:
#   LLM_API_KEY=keyring:deepseek,default
#   ANTHROPIC_API_KEY=keyring:anthropic,default

# --- LLM provider -----------------------------------------------------------
# "local"    use llama.cpp (default, no key needed)
# "deepseek" use DeepSeek via OpenAI-compatible API
# "openai"   use OpenAI
LLM_PROVIDER=local

# Cloud model ID (ignored when LLM_PROVIDER=local)
LLM_MODEL=deepseek-chat

# API key — use an indirect reference so the secret stays in your shell:
LLM_API_KEY=$DEEPSEEK_API_KEY
# Alternatively: LLM_API_KEY=keyring:deepseek,default

# Override API base URL (optional — leave blank to use provider default)
# LLM_BASE_URL=https://api.deepseek.com

# Set to "0" to disable JSON-mode for providers that don't support it
# LLM_JSON_MODE=1

# --- Local model ------------------------------------------------------------
# EVAL_MODEL_PATH=../models/Phi-3.5-mini-instruct-Q3_K_M.gguf

# --- Dev-orchestrator (scripts/architect.py, scripts/llm_review.py) --------
# Always calls the real Anthropic API regardless of LLM_PROVIDER above.
ANTHROPIC_API_KEY=$CLAUDE_API_KEY

# --- Cost tracking (optional) -----------------------------------------------
# LLM_INPUT_PRICE_PER_MILLION=0.27    # DeepSeek-chat input (cache miss)
# LLM_OUTPUT_PRICE_PER_MILLION=1.10   # DeepSeek-chat output

# --- Game paths (optional overrides) ----------------------------------------
# LEVEL9_INTERPRETER=./tools/glklevel9
# LEVEL9_ROM=./gamefiles/knight-orc/GAMEDAT1.DAT
# GAME_CONFIG=configs/knight_orc.json
# GAME_STRATEGY=configs/knight_orc_strategy.json
